<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- The CI project references packages freshly built in this repo -->
    <add key="sharpliner-local" value="artifacts/package/release" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="azure-default" value="https://packagefeedproxy.microsoft.io/nuget/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="sharpliner-local">
      <package pattern="Sharpliner*" />
      <package pattern="E2E.Tests.Sharpliner*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="azure-default">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
  <disabledPackageSources />
</configuration>
